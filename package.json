{
  "name": "aub-course-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/devAll.cjs",
    "dev:client": "npm --prefix CoursePlannerr run dev:client",
    "server": "node server.cjs",
    "start": "node server.cjs",
    "build": "npm --prefix CoursePlannerr run build",
    "autostart:install": "powershell -ExecutionPolicy Bypass -File scripts/windows/install-termer-autostart.ps1",
    "autostart:remove": "powershell -ExecutionPolicy Bypass -File scripts/windows/remove-termer-autostart.ps1",
    "shortcut:install": "powershell -ExecutionPolicy Bypass -File scripts/windows/install-termer-desktop-shortcut.ps1",
    "server:hidden:start": "powershell -ExecutionPolicy Bypass -File scripts/windows/start-termer-hidden.ps1",
    "server:hidden:stop": "powershell -ExecutionPolicy Bypass -File scripts/windows/stop-termer.ps1",
    "catalogs:build": "node scripts/buildCatalogs.cjs",
    "curriculum:build": "node scripts/buildCurriculumPlans.cjs",
    "ai:audit": "node scripts/auditAiAdvisor.cjs",
    "curriculum:audit": "node scripts/auditCurriculumCoverage.cjs",
    "expertise:audit": "node scripts/auditMajorExpertise1000.cjs",
    "load:test": "node scripts/loadTestUsers.cjs",
    "lint": "eslint .",
    "preview": "npm --prefix CoursePlannerr run preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/generative-ai": "^0.24.1",
    "@huggingface/inference": "^4.13.12",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@napi-rs/canvas": "^1.0.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.90.20",
    "cloudscraper": "^4.6.0",
    "cookie": "^0.7.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "groq-sdk": "^1.1.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.58.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "request": "^2.88.2",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.2.4"
  }
}
